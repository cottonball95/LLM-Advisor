# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to git! Add it to .gitignore

# PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database?sslmode=require
[connections.postgres]
url = "postgresql://postgres:YOUR_PASSWORD@db.example.supabase.co:5432/postgres?sslmode=require"

# OpenAI API Key (required for LLM features)
[openai]
api_key = "sk-your-openai-api-key-here"

